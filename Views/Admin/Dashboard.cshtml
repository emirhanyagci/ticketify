@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Dashboard";
    var hasFilters = !string.IsNullOrWhiteSpace(Model.Search)
        || !string.IsNullOrWhiteSpace(Model.StatusFilter)
        || !string.IsNullOrWhiteSpace(Model.DepartmentFilter)
        || !string.IsNullOrWhiteSpace(Model.PriorityFilter)
        || !string.IsNullOrWhiteSpace(Model.AssigneeFilter)
        || Model.DateFrom.HasValue
        || Model.DateTo.HasValue;
}

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title">
                    <i class="bi bi-speedometer2 me-2"></i>Admin Dashboard
                </h1>
                <p class="page-subtitle">Tüm destek taleplerini yönetin</p>
            </div>
        </div>
    </div>
</div>

<div class="container page-content">
    <!-- İstatistik Kartları -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-2half">
            <a href="@Url.Action("Dashboard", "Admin")" class="stat-card stat-total @(string.IsNullOrEmpty(Model.StatusFilter) ? "active" : "")">
                <div class="stat-value">@Model.TotalCount</div>
                <div class="stat-label"><i class="bi bi-collection me-1"></i>Toplam</div>
            </a>
        </div>
        <div class="col-6 col-md-2half">
            <a href="@Url.Action("Dashboard", "Admin", new { status = "Open" })" class="stat-card stat-open @(Model.StatusFilter == "Open" ? "active" : "")">
                <div class="stat-value">@Model.OpenCount</div>
                <div class="stat-label"><i class="bi bi-envelope-open me-1"></i>Açık</div>
            </a>
        </div>
        <div class="col-6 col-md-2half">
            <a href="@Url.Action("Dashboard", "Admin", new { status = "InProgress" })" class="stat-card stat-inprogress @(Model.StatusFilter == "InProgress" ? "active" : "")">
                <div class="stat-value">@Model.InProgressCount</div>
                <div class="stat-label"><i class="bi bi-arrow-repeat me-1"></i>İşlemde</div>
            </a>
        </div>
        <div class="col-6 col-md-2half">
            <a href="@Url.Action("Dashboard", "Admin", new { status = "Resolved" })" class="stat-card stat-resolved @(Model.StatusFilter == "Resolved" ? "active" : "")">
                <div class="stat-value">@Model.ResolvedCount</div>
                <div class="stat-label"><i class="bi bi-check-circle me-1"></i>Çözüldü</div>
            </a>
        </div>
        <div class="col-6 col-md-2half">
            <a href="@Url.Action("Dashboard", "Admin", new { assignee = "unassigned" })" class="stat-card stat-unassigned @(Model.AssigneeFilter == "unassigned" ? "active" : "")">
                <div class="stat-value">@Model.UnassignedCount</div>
                <div class="stat-label"><i class="bi bi-person-dash me-1"></i>Atanmamış</div>
            </a>
        </div>
    </div>

    <!-- Filtreler -->
    <div class="dashboard-filter-panel mb-4">
        <form asp-action="Dashboard" method="get">
            <div class="row g-3 align-items-end">
                <div class="col-12 col-lg-4">
                    <label class="filter-label" for="search">Arama</label>
                    <div class="filter-search-wrap">
                        <i class="bi bi-search"></i>
                        <input id="search" name="search" value="@Model.Search" class="form-control form-control-custom filter-search-input"
                               placeholder="Başlık, açıklama, bildiren veya atanan" />
                    </div>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="filter-label" for="status">Durum</label>
                    <select id="status" name="status" class="form-select form-control-custom">
                        <option value="">Tümü</option>
                        @foreach (var option in AdminDashboardViewModel.StatusOptions)
                        {
                            <option value="@option.Key" selected="@(Model.StatusFilter == option.Key)">@option.Value</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="filter-label" for="department">Departman</label>
                    <select id="department" name="department" class="form-select form-control-custom">
                        <option value="">Tümü</option>
                        @foreach (var option in AdminDashboardViewModel.DepartmentOptions)
                        {
                            <option value="@option.Key" selected="@(Model.DepartmentFilter == option.Key)">@option.Value</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="filter-label" for="priority">Öncelik</label>
                    <select id="priority" name="priority" class="form-select form-control-custom">
                        <option value="">Tümü</option>
                        @foreach (var option in AdminDashboardViewModel.PriorityOptions)
                        {
                            <option value="@option.Key" selected="@(Model.PriorityFilter == option.Key)">@option.Value</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="filter-label" for="assignee">Atanan</label>
                    <select id="assignee" name="assignee" class="form-select form-control-custom">
                        <option value="">Tümü</option>
                        <option value="unassigned" selected="@(Model.AssigneeFilter == "unassigned")">Atanmamış</option>
                        @foreach (var employee in Model.Employees)
                        {
                            <option value="@employee.Id" selected="@(Model.AssigneeFilter == employee.Id.ToString())">@employee.FullName</option>
                        }
                    </select>
                </div>
                <div class="col-6 col-lg-2">
                    <label class="filter-label" for="dateFrom">Başlangıç</label>
                    <input id="dateFrom" name="dateFrom" type="date" value="@Model.DateFrom?.ToString("yyyy-MM-dd")" class="form-control form-control-custom" />
                </div>
                <div class="col-6 col-lg-2">
                    <label class="filter-label" for="dateTo">Bitiş</label>
                    <input id="dateTo" name="dateTo" type="date" value="@Model.DateTo?.ToString("yyyy-MM-dd")" class="form-control form-control-custom" />
                </div>
                <div class="col-12 col-lg filter-actions">
                    <button type="submit" class="btn btn-primary-custom">
                        <i class="bi bi-funnel me-2"></i>Filtrele
                    </button>
                    @if (hasFilters)
                    {
                        <a asp-action="Dashboard" class="btn btn-secondary-custom">
                            <i class="bi bi-x-circle me-2"></i>Temizle
                        </a>
                    }
                </div>
            </div>
        </form>
    </div>

    <!-- Ticket Tablosu -->
    @if (!Model.Tickets.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-inbox-fill"></i>
            </div>
            <h3 class="empty-title">
                @(hasFilters ? "Bu Filtrede Ticket Yok" : "Henüz Ticket Bulunmuyor")
            </h3>
            <p class="empty-desc">
                @(!hasFilters
                    ? "Sisteme henüz hiç destek talebi açılmamış."
                    : "Seçtiğiniz arama ve filtrelere uyan destek talebi bulunmuyor.")
            </p>
            @if (hasFilters)
            {
                <a asp-action="Dashboard" class="btn btn-secondary-custom">
                    <i class="bi bi-x-circle me-2"></i>Filtreyi Temizle
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th style="width:60px">#ID</th>
                            <th>Başlık / Açıklama</th>
                            <th style="width:120px">Departman</th>
                            <th style="width:160px">Bildiren</th>
                            <th style="width:160px">Atanan</th>
                            <th style="width:100px">Öncelik</th>
                            <th style="width:150px">Durum</th>
                            <th style="width:110px">Tarih</th>
                            <th style="width:80px">İşlem</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr>
                                <td><span class="ticket-id">#@ticket.Id</span></td>
                                <td>
                                    <a asp-controller="Ticket" asp-action="Details" asp-route-id="@ticket.Id" class="ticket-title-link">
                                        @ticket.Title
                                    </a>
                                    @if (ticket.Description.Length > 60)
                                    {
                                        <div class="ticket-desc">@ticket.Description.Substring(0, 60)…</div>
                                    }
                                    else
                                    {
                                        <div class="ticket-desc">@ticket.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="dept-badge dept-@ticket.Department.ToLower()">
                                        @(ticket.Department switch {
                                            "Software" => "Yazılım",
                                            "Hardware" => "Donanım",
                                            "Network" => "Ağ / Altyapı",
                                            "Other" => "Diğer",
                                            _ => "Genel"
                                        })
                                    </span>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        @if (!string.IsNullOrEmpty(ticket.UserAvatarUrl))
                                        {
                                            <img src="@ticket.UserAvatarUrl" alt="@ticket.UserFullName" class="avatar-circle avatar-xs" />
                                        }
                                        else
                                        {
                                            <div class="avatar-fallback avatar-xs"><i class="bi bi-person-fill"></i></div>
                                        }
                                        <span class="small text-muted">@(string.IsNullOrEmpty(ticket.UserFullName) ? ticket.UserEmail : ticket.UserFullName)</span>
                                    </div>
                                </td>
                                <td>
                                    @if (ticket.AssigneeId.HasValue)
                                    {
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(ticket.AssigneeAvatarUrl))
                                            {
                                                <img src="@ticket.AssigneeAvatarUrl" alt="@ticket.AssigneeFullName" class="avatar-circle avatar-xs" />
                                            }
                                            else
                                            {
                                                <div class="avatar-fallback avatar-xs"><i class="bi bi-person-fill"></i></div>
                                            }
                                            <span class="small text-muted">@ticket.AssigneeFullName</span>
                                            @if (ticket.AssigneeId.HasValue)
                                            {
                                                <span class="workload-badge" title="Aktif ticket sayısı">
                                                    @Model.EmployeeActiveTicketCounts.GetValueOrDefault(ticket.AssigneeId.Value)
                                                </span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="quick-assign-wrap">
                                            <span class="unassigned-badge-sm">
                                                <i class="bi bi-person-dash me-1"></i>Atanmamış
                                            </span>
                                            @if (Model.SuggestedAssignees.TryGetValue(ticket.Id, out var suggestedEmployee))
                                            {
                                                <div class="quick-assign-suggestion">
                                                    <i class="bi bi-magic"></i>
                                                    <span>@suggestedEmployee.FullName</span>
                                                    <span class="workload-badge" title="Aktif ticket sayısı">
                                                        @Model.EmployeeActiveTicketCounts.GetValueOrDefault(suggestedEmployee.Id)
                                                    </span>
                                                </div>
                                            }
                                        </div>
                                    }
                                </td>
                                <td>
                                    <span class="priority-badge priority-@ticket.Priority.ToLower()">
                                        @(ticket.Priority == "Low" ? "Düşük" : ticket.Priority == "Medium" ? "Orta" : "Yüksek")
                                    </span>
                                </td>
                                <td>
                                    <form asp-action="UpdateStatus" method="post" class="d-flex align-items-center">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="id" value="@ticket.Id" />
                                        <select name="status" class="form-select form-select-sm status-select status-@ticket.Status.ToLower()"
                                                onchange="this.form.submit()">
                                            @if (ticket.Status == "Open")
                                            {
                                                <option value="Open" selected>Açık</option>
                                                <option value="InProgress">İşlemde</option>
                                                <option value="Resolved">Çözüldü</option>
                                            }
                                            else if (ticket.Status == "InProgress")
                                            {
                                                <option value="Open">Açık</option>
                                                <option value="InProgress" selected>İşlemde</option>
                                                <option value="Resolved">Çözüldü</option>
                                            }
                                            else
                                            {
                                                <option value="Open">Açık</option>
                                                <option value="InProgress">İşlemde</option>
                                                <option value="Resolved" selected>Çözüldü</option>
                                            }
                                        </select>
                                    </form>
                                </td>
                                <td class="text-muted small">
                                    @ticket.CreatedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a asp-controller="Ticket" asp-action="Details" asp-route-id="@ticket.Id"
                                           class="btn-icon-sm" title="Detaylar">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                        @if (ticket.AssigneeId == null && Model.SuggestedAssignees.ContainsKey(ticket.Id))
                                        {
                                            <form asp-action="QuickAssignTicket" method="post" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="ticketId" value="@ticket.Id" />
                                                <button type="submit" class="btn-icon-sm btn-icon-success" title="Önerilen çalışana hızlı ata">
                                                    <i class="bi bi-person-check"></i>
                                                </button>
                                            </form>
                                        }
                                        <button type="button" class="btn-icon-sm btn-icon-danger"
                                                onclick="confirmDelete(@ticket.Id, '@Html.Raw(ticket.Title.Replace("'", "\\'"))')"
                                                title="Sil">
                                            <i class="bi bi-trash3"></i>
                                        </button>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span class="text-muted small">
                    @if (hasFilters)
                    {
                        <span>Filtreli sonuç —</span>
                    }
                    Toplam <strong>@Model.Tickets.Count()</strong> ticket gösteriliyor
                </span>
            </div>
        </div>
    }
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content modal-custom">
            <div class="modal-header border-0">
                <h5 class="modal-title fw-bold"><i class="bi bi-exclamation-triangle-fill text-warning me-2"></i>Silme Onayı</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p id="deleteModalText" class="mb-0"></p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-secondary-custom" data-bs-dismiss="modal">İptal</button>
                <form id="deleteForm" asp-action="Delete" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" id="deleteTicketId" name="id" />
                    <button type="submit" class="btn btn-danger-custom">
                        <i class="bi bi-trash3 me-2"></i>Evet, Sil
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
function confirmDelete(id, title) {
    document.getElementById('deleteTicketId').value = id;
    document.getElementById('deleteModalText').innerHTML =
        `<strong>#${id}</strong> numaralı "<em>${title}</em>" başlıklı ticket kalıcı olarak silinecek.`;
    new bootstrap.Modal(document.getElementById('deleteModal')).show();
}
</script>
}
