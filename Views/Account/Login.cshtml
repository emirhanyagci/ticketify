@model LoginViewModel
@{
    ViewData["Title"] = "Giriş Yap";
}

<div class="auth-page">
    <div class="container">
        <div class="row justify-content-center">
            <div class="col-md-5 col-lg-4">
                <div class="auth-card">
                    <div class="auth-header text-center mb-4">
                        <div class="auth-logo mb-3">
                            <i class="bi bi-ticket-detailed-fill"></i>
                        </div>
                        <h1 class="auth-title">Tekrar Hoş Geldiniz</h1>
                        <p class="auth-subtitle">Ticketify hesabınıza giriş yapın</p>
                    </div>

                    <form asp-action="Login" method="post" id="loginForm">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger-custom mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label-custom"></label>
                            <div class="input-group-custom">
                                <span class="input-icon"><i class="bi bi-envelope"></i></span>
                                <input asp-for="Email" class="form-control-custom" placeholder="e-posta adresiniz" autocomplete="email" />
                            </div>
                            <span asp-validation-for="Email" class="field-error"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label-custom"></label>
                            <div class="input-group-custom">
                                <span class="input-icon"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control-custom" placeholder="••••••••" autocomplete="current-password" />
                            </div>
                            <span asp-validation-for="Password" class="field-error"></span>
                        </div>

                        <button type="submit" class="btn btn-primary-custom w-100 mb-3">
                            <i class="bi bi-box-arrow-in-right me-2"></i>Giriş Yap
                        </button>
                    </form>

                    <button type="button" class="btn btn-autofill w-100 mb-3" id="btnAdminFill" onclick="fillAdmin()">
                        <i class="bi bi-lightning-charge-fill me-2"></i>Test: Admin Girişi
                    </button>

                    <div class="text-center">
                        <span class="text-muted small">Hesabınız yok mu?</span>
                        <a asp-action="Register" class="auth-link ms-1">Kayıt Olun</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    function fillAdmin() {
        document.getElementById('Email').value = 'admin@@ticketify.com';
        document.getElementById('Password').value = 'Admin123!';

        var btn = document.getElementById('btnAdminFill');
        btn.innerHTML = '<i class="bi bi-check-circle-fill me-2"></i>Dolduruldu!';
        btn.classList.add('filled');
        setTimeout(function() {
            btn.innerHTML = '<i class="bi bi-lightning-charge-fill me-2"></i>Test: Admin Girişi';
            btn.classList.remove('filled');
        }, 1500);
    }
    </script>
}
