@model TicketListViewModel
@{
    ViewData["Title"] = Model.UserRole == "Employee" ? "Atanan Ticket'larım" : "Ticket'larım";
    var isEmployee = Model.UserRole == "Employee";
}

<div class="page-header">
    <div class="container">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title">
                    <i class="bi @(isEmployee ? "bi-person-workspace" : "bi-list-ul") me-2"></i>
                    @(isEmployee ? "Atanan Ticket'larım" : "Ticket'larım")
                </h1>
                <p class="page-subtitle">
                    @(isEmployee ? "Size atanan destek talepleri" : "Açtığınız tüm destek talepleri")
                </p>
            </div>
            @if (!isEmployee)
            {
                <div class="col-auto">
                    <a asp-action="Create" class="btn btn-primary-custom">
                        <i class="bi bi-plus-circle me-2"></i>Yeni Ticket
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<div class="container page-content">
    @if (!Model.Tickets.Any())
    {
        <div class="empty-state">
            <div class="empty-icon">
                <i class="bi bi-inbox-fill"></i>
            </div>
            <h3 class="empty-title">
                @(isEmployee ? "Size Atanmış Ticket Yok" : "Henüz Ticket Açmadınız")
            </h3>
            <p class="empty-desc">
                @(isEmployee
                    ? "Yönetici size bir ticket atadığında burada görünecek."
                    : "Bir sorunla mı karşılaştınız? Hemen destek talebi oluşturun.")
            </p>
            @if (!isEmployee)
            {
                <a asp-action="Create" class="btn btn-primary-custom">
                    <i class="bi bi-plus-circle me-2"></i>İlk Ticket'ımı Oluştur
                </a>
            }
        </div>
    }
    else
    {
        <div class="table-card">
            <div class="table-responsive">
                <table class="table table-custom">
                    <thead>
                        <tr>
                            <th style="width:60px">#ID</th>
                            <th>Başlık</th>
                            <th style="width:130px">Departman</th>
                            @if (isEmployee)
                            {
                                <th style="width:150px">Bildiren</th>
                            }
                            <th style="width:120px">Öncelik</th>
                            <th style="width:130px">Durum</th>
                            <th style="width:160px">Tarih</th>
                            <th style="width:80px">Detay</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var ticket in Model.Tickets)
                        {
                            <tr>
                                <td><span class="ticket-id">#@ticket.Id</span></td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="ticket-title-link">
                                        @ticket.Title
                                    </a>
                                    @if (ticket.Description.Length > 80)
                                    {
                                        <div class="ticket-desc">@ticket.Description.Substring(0, 80)…</div>
                                    }
                                    else
                                    {
                                        <div class="ticket-desc">@ticket.Description</div>
                                    }
                                </td>
                                <td>
                                    <span class="dept-badge dept-@ticket.Department.ToLower()">
                                        @(ticket.Department switch {
                                            "Software" => "Yazılım",
                                            "Hardware" => "Donanım",
                                            "Network" => "Ağ / Altyapı",
                                            "Other" => "Diğer",
                                            _ => "Genel"
                                        })
                                    </span>
                                </td>
                                @if (isEmployee)
                                {
                                    <td>
                                        <div class="d-flex align-items-center gap-2">
                                            @if (!string.IsNullOrEmpty(ticket.UserAvatarUrl))
                                            {
                                                <img src="@ticket.UserAvatarUrl" alt="@ticket.UserFullName" class="avatar-circle avatar-xs" />
                                            }
                                            <span class="small text-muted">@ticket.UserFullName</span>
                                        </div>
                                    </td>
                                }
                                <td>
                                    <span class="priority-badge priority-@ticket.Priority.ToLower()">
                                        @(ticket.Priority == "Low" ? "Düşük" : ticket.Priority == "Medium" ? "Orta" : "Yüksek")
                                    </span>
                                </td>
                                <td>
                                    <span class="status-badge status-@ticket.Status.ToLower()">
                                        @(ticket.Status == "Open" ? "Açık" : ticket.Status == "InProgress" ? "İşlemde" : "Çözüldü")
                                    </span>
                                </td>
                                <td class="text-muted small">
                                    <i class="bi bi-clock me-1"></i>@ticket.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@ticket.Id" class="btn-icon-sm" title="Detaylar">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="table-footer">
                <span class="text-muted small">Toplam <strong>@Model.Tickets.Count()</strong> ticket</span>
            </div>
        </div>
    }
</div>
